# Cloud Environment Configuration Template
# Copy this to .env and fill in your actual values

# ================================
# CLOUD AGENT CONFIGURATION
# ================================

# Agent identification
AGENT_TYPE=cloud
NODE_ENV=production

# ================================
# VAULT SYNCHRONIZATION
# ================================

# Git repository for vault sync (REQUIRED)
VAULT_REPO_URL=https://github.com/yourusername/ai-employee-vault.git

# Local vault path on cloud VM
VAULT_PATH=/home/ubuntu/ai-employee/vault-sync

# Sync interval in seconds (60 = 1 minute)
SYNC_INTERVAL=60

# Git credentials (if using HTTPS with token)
GIT_USERNAME=your-github-username
GIT_TOKEN=your-github-personal-access-token

# ================================
# GMAIL INTEGRATION
# ================================

# Gmail API credentials path
GMAIL_CREDENTIALS_PATH=/home/ubuntu/ai-employee/config/credentials.json

# Gmail check interval in seconds (300 = 5 minutes)
GMAIL_CHECK_INTERVAL=300

# ================================
# SECURITY SETTINGS
# ================================

# Maximum file size for processing (in bytes)
MAX_FILE_SIZE=10485760

# Maximum emails to process per batch
MAX_EMAILS_PER_BATCH=10

# Approval timeout in hours
APPROVAL_TIMEOUT_HOURS=24

# ================================
# SYSTEM MONITORING
# ================================

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=300

# Log retention in days
LOG_RETENTION_DAYS=7

# Report retention in days
REPORT_RETENTION_DAYS=30

# ================================
# PROCESS MANAGEMENT
# ================================

# Maximum memory per process (PM2 setting)
MAX_MEMORY_RESTART=500M

# Maximum restart attempts
MAX_RESTART_ATTEMPTS=5

# ================================
# CLOUD PROVIDER SETTINGS
# ================================

# Oracle Cloud specific settings
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_ID=your-compartment-id

# Timezone for scheduling
TZ=UTC

# ================================
# NOTIFICATION SETTINGS
# ================================

# Webhook URL for alerts (optional)
ALERT_WEBHOOK_URL=

# Email for system alerts (optional)
ALERT_EMAIL=

# ================================
# DEVELOPMENT/DEBUG
# ================================

# Enable debug logging (true/false)
DEBUG_MODE=false

# Dry run mode (true/false) - prevents actual external actions
DRY_RUN=false

# ================================
# SECURITY NOTES
# ================================
#
# NEVER commit this file to version control!
# Add .env to your .gitignore immediately
#
# Rotate credentials monthly
# Use strong, unique passwords
# Enable 2FA where possible
#
# For production deployment:
# - Use environment variables instead of .env file
# - Store secrets in proper secret management system
# - Enable audit logging
# - Monitor access patterns
