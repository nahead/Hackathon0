# Railway Environment Variables Template
# Copy this to Railway Dashboard → Variables

# Required: Agent Configuration
AGENT_TYPE=cloud
RAILWAY_ENVIRONMENT=production
NODE_ENV=production

# Required: Gmail Configuration
SMTP_USER=naheadj@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Required: Vault Sync (Create GitHub repo first)
VAULT_REPO_URL=https://github.com/YOUR-USERNAME/ai-employee-vault.git
GIT_USERNAME=your-github-username
GIT_TOKEN=your-github-personal-access-token

# Optional: Odoo Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=ai_employee
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Optional: Port (Railway sets automatically)
PORT=8080
