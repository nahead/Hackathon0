{
  "name": "odoo-integration",
  "version": "1.0.0",
  "description": "MCP Server for Odoo Community Integration - AI Employee System",
  "main": "odoo_mcp_server.py",
  "scripts": {
    "start": "python odoo_mcp_server.py",
    "test": "python -m pytest tests/",
    "install-odoo": "python ../odoo_integration.py"
  },
  "mcp": {
    "server": {
      "command": "python",
      "args": ["odoo_mcp_server.py"],
      "env": {
        "PYTHONPATH": ".."
      }
    },
    "capabilities": [
      "accounting",
      "invoicing", 
      "expense_tracking",
      "financial_reporting",
      "partner_management"
    ],
    "methods": [
      "odoo.test_connection",
      "odoo.create_invoice", 
      "odoo.record_expense",
      "odoo.get_financial_summary",
      "odoo.find_partner",
      "odoo.list_invoices",
      "odoo.get_account_balance"
    ]
  },
  "dependencies": {
    "requests": ">=2.25.0",
    "python": ">=3.8"
  },
  "author": "AI Employee System",
  "license": "MIT"
}
