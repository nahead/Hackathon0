# Vault .gitignore - Security Rules
# CRITICAL: Secrets never sync

# Environment files
.env
*.env
.env.*

# Credentials
*.json
credentials/
.credentials/

# Sessions
.session/
*.session
session_*

# Banking
banking/
*.bank

# Private keys
*.key
*.pem
*.p12

# Logs (optional - can sync if needed)
Logs/*.log

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# WhatsApp session
.wwebjs_auth/
.wwebjs_cache/
