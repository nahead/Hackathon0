{
  "client_onboarding": {
    "workflow_id": "client_onboarding",
    "name": "New Client Onboarding",
    "description": "Complete client onboarding across all business domains",
    "trigger_event": "new_client_email",
    "auto_execute": false,
    "steps": [
      {
        "step_id": "create_client_record",
        "domain": "accounting",
        "action": "create_partner",
        "parameters": {
          "extract_from_email": true
        },
        "depends_on": [],
        "timeout_seconds": 300
      },
      {
        "step_id": "send_welcome_email",
        "domain": "email",
        "action": "send_template_email",
        "parameters": {
          "template": "client_welcome"
        },
        "depends_on": [
          "create_client_record"
        ],
        "timeout_seconds": 300
      },
      {
        "step_id": "schedule_followup",
        "domain": "scheduling",
        "action": "create_task",
        "parameters": {
          "task_type": "client_followup",
          "days_ahead": 3
        },
        "depends_on": [
          "send_welcome_email"
        ],
        "timeout_seconds": 300
      },
      {
        "step_id": "announce_new_client",
        "domain": "social_media",
        "action": "create_announcement_post",
        "parameters": {
          "type": "new_client",
          "requires_approval": true
        },
        "depends_on": [
          "create_client_record"
        ],
        "timeout_seconds": 300
      }
    ]
  },
  "payment_received": {
    "workflow_id": "payment_received",
    "name": "Invoice Payment Processing",
    "description": "Process received payments across all systems",
    "trigger_event": "payment_received",
    "auto_execute": true,
    "steps": [
      {
        "step_id": "update_invoice_status",
        "domain": "accounting",
        "action": "mark_invoice_paid",
        "parameters": {
          "invoice_id": "{event.invoice_id}"
        },
        "depends_on": [],
        "timeout_seconds": 300
      },
      {
        "step_id": "send_payment_confirmation",
        "domain": "email",
        "action": "send_template_email",
        "parameters": {
          "template": "payment_confirmation"
        },
        "depends_on": [
          "update_invoice_status"
        ],
        "timeout_seconds": 300
      },
      {
        "step_id": "update_financial_dashboard",
        "domain": "content",
        "action": "generate_financial_update",
        "parameters": {
          "type": "payment_received"
        },
        "depends_on": [
          "update_invoice_status"
        ],
        "timeout_seconds": 300
      }
    ]
  },
  "weekly_business_review": {
    "workflow_id": "weekly_business_review",
    "name": "Weekly Business Review",
    "description": "Generate comprehensive weekly business review",
    "trigger_event": "weekly_review_scheduled",
    "auto_execute": true,
    "steps": [
      {
        "step_id": "gather_financial_data",
        "domain": "accounting",
        "action": "get_financial_summary",
        "parameters": {
          "period": "week"
        },
        "depends_on": [],
        "timeout_seconds": 300
      },
      {
        "step_id": "gather_social_metrics",
        "domain": "social_media",
        "action": "get_engagement_metrics",
        "parameters": {
          "period": "week"
        },
        "depends_on": [],
        "timeout_seconds": 300
      },
      {
        "step_id": "gather_email_stats",
        "domain": "email",
        "action": "get_email_statistics",
        "parameters": {
          "period": "week"
        },
        "depends_on": [],
        "timeout_seconds": 300
      },
      {
        "step_id": "generate_review_report",
        "domain": "content",
        "action": "create_business_review",
        "parameters": {
          "combine_all_data": true
        },
        "depends_on": [
          "gather_financial_data",
          "gather_social_metrics",
          "gather_email_stats"
        ],
        "timeout_seconds": 300
      },
      {
        "step_id": "schedule_ceo_briefing",
        "domain": "scheduling",
        "action": "create_briefing_task",
        "parameters": {
          "priority": "high"
        },
        "depends_on": [
          "generate_review_report"
        ],
        "timeout_seconds": 300
      }
    ]
  }
}